  <Sql TableName="AISIWebhookSecret" TableSchemaXml="#CDATA">
    <CDATA name="TableSchemaXml"><![CDATA[<table name="AISIWebhookSecret">
    <col name="CompanyID" type="Int" default="Zero" />
    <col name="WebHookID" type="UniqueIdentifier" />
    <col name="Secret" type="NVarChar(2048)" nullable="true" />
    <col name="SecretEncoding" type="Char(1)" nullable="true" />
    <col name="RotatingSecret" type="NVarChar(2048)" nullable="true" />
    <col name="RotatingExpiresOn" type="DateTime" nullable="true" />
    <col name="AllowedAddresses" type="VarChar(500)" nullable="true" />
    <col name="ClientAddressHeader" type="VarChar(64)" nullable="true" />
    <col name="TrustedProxyDepth" type="Int" nullable="true" />
    <col name="NoteID" type="UniqueIdentifier" nullable="true" />
    <col name="tstamp" type="Timestamp" />
    <col name="CreatedByID" type="UniqueIdentifier" />
    <col name="CreatedByScreenID" type="Char(8)" />
    <col name="CreatedDateTime" type="DateTime" />
    <col name="LastModifiedByID" type="UniqueIdentifier" />
    <col name="LastModifiedByScreenID" type="Char(8)" />
    <col name="LastModifiedDateTime" type="DateTime" />
    <index name="AISIWebhookSecret_PK" clustered="true" primary="true" unique="true">
      <col name="CompanyID" />
      <col name="WebHookID" />
    </index>
  </table>]]></CDATA>
  </Sql>
  <Sql TableName="AISIWebhookRetry" TableSchemaXml="#CDATA">
    <CDATA name="TableSchemaXml"><![CDATA[<table name="AISIWebhookRetry">
    <col name="CompanyID" type="Int" default="Zero" />
    <col name="RetryID" type="Int" identity="true" />
    <col name="WebHookID" type="UniqueIdentifier" />
    <col name="ReceivedOn" type="DateTime" />
    <col name="Status" type="Char(1)" />
    <col name="AttemptCount" type="Int" default="Zero" />
    <col name="LastAttemptOn" type="DateTime" nullable="true" />
    <col name="TraceIdentifier" type="VarChar(64)" nullable="true" />
    <col name="HandlerType" type="VarChar(256)" />
    <col name="Method" type="VarChar(16)" nullable="true" />
    <col name="ContentType" type="VarChar(128)" nullable="true" />
    <col name="FailureMessage" type="NVarChar(1024)" nullable="true" />
    <col name="Body" type="VarBinary(MAX)" nullable="true" />
    <col name="NoteID" type="UniqueIdentifier" nullable="true" />
    <col name="tstamp" type="Timestamp" />
    <col name="CreatedByID" type="UniqueIdentifier" />
    <col name="CreatedByScreenID" type="Char(8)" />
    <col name="CreatedDateTime" type="DateTime" />
    <col name="LastModifiedByID" type="UniqueIdentifier" />
    <col name="LastModifiedByScreenID" type="Char(8)" />
    <col name="LastModifiedDateTime" type="DateTime" />
    <index name="AISIWebhookRetry_PK" clustered="true" primary="true" unique="true">
      <col name="CompanyID" />
      <col name="RetryID" />
    </index>
    <index name="AISIWebhookRetry_Status">
      <col name="CompanyID" />
      <col name="Status" />
      <col name="ReceivedOn" />
    </index>
    <index name="AISIWebhookRetry_WebHook">
