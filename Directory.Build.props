<Project>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>AISI Dev Co</Authors>
    <Company>AISI Dev Co</Company>
    <Copyright>Copyright (c) 2026 AISI Dev Co</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/AISI-Dev-Co/AISI.AcumaticaWebhookAuthenticator</RepositoryUrl>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Without this the dotnet_diagnostic entries in .editorconfig are inert - the rules they
      configure are never run. Configuration that looks like it is enforcing something and is not
      is worse than no configuration at all.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
  </PropertyGroup>

  <!--
    Shared plumbing for every project that references licensed PX.* assemblies from a site Bin
    (opted into with <RequiresAcumaticaBin>true</RequiresAcumaticaBin>), kept in one place so the
    guard, the environment fallback and the analyzer set cannot drift between projects.

    Where the assemblies come from: set AcumaticaBinPath on the command line
    (-p:AcumaticaBinPath=...) or via the ACUMATICA_BIN environment variable. There is no default:
    guessing a site path would make the build succeed or fail depending on what happens to be
    installed, and reference whatever version it found.
  -->
  <PropertyGroup Condition="'$(RequiresAcumaticaBin)' == 'true' And '$(AcumaticaBinPath)' == ''">
    <AcumaticaBinPath>$(ACUMATICA_BIN)</AcumaticaBinPath>
  </PropertyGroup>

  <!--
    A loud, early failure rather than a pile of CS0246s. These projects must never silently no-op
    when the Bin is missing: a build that skips compilation and still reports success is the
    false-verification defect this repository has already been bitten by.
  -->
  <Target Name="EnsureAcumaticaBinPath"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(RequiresAcumaticaBin)' == 'true'">
    <Error Condition="'$(AcumaticaBinPath)' == ''"
           Text="AcumaticaBinPath is not set. Point it at a local Acumatica site's Bin directory, e.g. dotnet build -p:AcumaticaBinPath=&quot;C:\AcumaticaSites\MySite\Bin&quot;, or set the ACUMATICA_BIN environment variable." />
    <Error Condition="'$(AcumaticaBinPath)' != '' And !Exists('$(AcumaticaBinPath)\PX.Api.Webhooks.Abstractions.dll')"
           Text="'$(AcumaticaBinPath)' does not contain PX.Api.Webhooks.Abstractions.dll. AcumaticaBinPath must point at an Acumatica 2025 R2+ site's Bin directory." />
  </Target>

  <!--
    Acumatica's own Roslyn analyzers, active on every build of a PX-referencing project (they fire
    only on code that uses PX.*, so putting them on the core would be configuration that looks
    live and is not). With TreatWarningsAsErrors on, an Acuminator diagnostic fails the build -
    including the local release build that produces the committed customization-package DLL.
  -->
  <ItemGroup Condition="'$(RequiresAcumaticaBin)' == 'true'">
    <PackageReference Include="Acuminator.Analyzers" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
